{
  "name": "minimal",
  "description": "Minimal Spec Kit SDD flow: driver agent, /sdd command, spec-kit context files, and the delegation subagents.",
  "components": [
    "agent:spec-kit-driver",
    "command:sdd",
    "context:spec-kit-navigation",
    "context:spec-kit-workflow",
    "context:spec-kit-artifacts",
    "context:spec-kit-wave-execution",
    "context:spec-kit-evidence",
    "subagent:contextscout",
    "subagent:externalscout",
    "subagent:task-manager",
    "subagent:coder-agent",
    "subagent:batch-executor",
    "subagent:test-engineer",
    "subagent:documentation",
    "context:code-quality"
  ],
  "settings": {
    "wave_strategy": "auto",
    "parallel_threshold": 5,
    "validation": { "commands": [], "scope": "repo" },
    "converge_loop": true
  }
}
