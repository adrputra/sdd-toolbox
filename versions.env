# =============================================================================
# versions.env — single source of truth for pinned external versions.
#
# This file is bash-sourceable and must contain ONLY plain `NAME=value` lines
# (plus comments). It must source cleanly under `set -u` in bash 3.2+. Every
# script reads its pins from here — do not duplicate a version elsewhere.
#
#   OAC_VERSION      Pinned OpenAgents Control (OAC) component subset version.
#                    Vendored snapshot: shipgo-backend-go/.opencode, 2026-09-19.
#   SPEC_KIT_VERSION Pinned GitHub Spec Kit release tag (e.g. vX.Y.Z).
#                    Resolved from the latest stable release tag and recorded
#                    by lib/spec_kit.sh (T11).
# =============================================================================

OAC_VERSION="0.5.2"
SPEC_KIT_VERSION="v1.0.8"
